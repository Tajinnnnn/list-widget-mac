{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "cache-control", "value": "no-store" }]
    }
  ]
}
